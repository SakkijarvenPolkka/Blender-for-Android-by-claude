<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 draws edge-to-edge by default for apps targeting API 35 and ignores the
         display cut-out mode: opt out, the camera cut-out would cover parts of Blender's UI. -->
    <style name="Theme.Blender" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/blender_background</item>
        <item name="android:statusBarColor">@color/blender_background</item>
        <item name="android:navigationBarColor">@color/blender_background</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
