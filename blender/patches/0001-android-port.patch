+void GHOST_ContextVK::androidUpdateSurface()
+{
+  if (android_window_info_->native_window == android_surface_window_ &&
+      android_window_info_->generation == android_surface_generation_ && !android_surface_lost_ &&
+      (surface_ != VK_NULL_HANDLE || android_surface_window_ == nullptr))
+  {
+    return;
+  }
+  CLOG_INFO(&LOG,
+            "Android: native window changed (%p -> %p), recreating surface",
+            (void *)android_surface_window_,
+            (void *)android_window_info_->native_window);
+
+  GHOST_InstanceVK &instance_vk = vulkan_instance.value();
+  GHOST_DeviceVK &device_vk = instance_vk.device.value();
+  VkDevice vk_device = device_vk.vk_device;
+  device_vk.wait_idle();
+
+  /* Everything that references the old surface must be destroyed before the surface. */
+  for (GHOST_Frame &frame : frame_data_) {
+    for (VkSwapchainKHR swapchain : frame.discard_pile.swapchains) {
+      this->destroySwapchainPresentFences(swapchain);
+    }
+    frame.discard_pile.destroy(vk_device);
+    /* An acquire semaphore may still be signaled by an acquire that wasn't waited on. */
+    if (frame.acquire_semaphore != VK_NULL_HANDLE) {
+      vkDestroySemaphore(vk_device, frame.acquire_semaphore, nullptr);
+      frame.acquire_semaphore = VK_NULL_HANDLE;
+    }
+  }
+  if (swapchain_ != VK_NULL_HANDLE) {
+    this->destroySwapchainPresentFences(swapchain_);
+    vkDestroySwapchainKHR(vk_device, swapchain_, nullptr);
+    swapchain_ = VK_NULL_HANDLE;
+  }
+  for (GHOST_SwapchainImage &swapchain_image : swapchain_images_) {
+    swapchain_image.destroy(vk_device);
+  }
+  swapchain_images_.clear();
+  if (surface_ != VK_NULL_HANDLE) {
+    vkDestroySurfaceKHR(instance_vk.vk_instance, surface_, nullptr);
+    surface_ = VK_NULL_HANDLE;
