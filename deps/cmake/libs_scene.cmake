#
# Volumes (OpenVDB & NanoVDB with Blosc compression), Alembic caches and MaterialX.

add_cmake_dep(blosc BLOSC
  DEPENDS external_zlib external_zstd
  CMAKE_ARGS
    -DBUILD_TESTS=OFF
    -DBUILD_BENCHMARKS=OFF
    -DBUILD_SHARED=OFF
    -DBUILD_STATIC=ON
    -DDEACTIVATE_SNAPPY=ON
    -DDEACTIVATE_ZLIB=ON
    -DDEACTIVATE_ZSTD=ON
    -DCMAKE_C_STANDARD=17
)

add_cmake_dep(openvdb OPENVDB
  DEPENDS external_tbb external_zlib external_blosc
  CMAKE_ARGS
    -DUSE_STATIC_DEPENDENCIES=OFF
    -DBLOSC_USE_STATIC_LIBS=ON
    -DTBB_USE_STATIC_LIBS=ON
    -DBlosc_ROOT=${LIBDIR}
    -DTBB_ROOT=${LIBDIR}
    -DZLIB_ROOT=${LIBDIR}
    -DOPENVDB_BUILD_UNITTESTS=OFF
    -DOPENVDB_BUILD_BINARIES=OFF
    -DOPENVDB_BUILD_PYTHON_MODULE=OFF
    -DOPENVDB_CORE_SHARED=OFF
    -DOPENVDB_CORE_STATIC=ON
    -DOPENVDB_BUILD_NANOVDB=ON
    -DUSE_NANOVDB=ON
    -DNANOVDB_BUILD_TOOLS=OFF
    -DOPENVDB_USE_DELAYED_LOADING=OFF
    -DUSE_EXPLICIT_INSTANTIATION=OFF
    -DDISABLE_DEPENDENCY_VERSION_CHECKS=ON
)

add_cmake_dep(alembic ALEMBIC
  DEPENDS external_imath
  CMAKE_ARGS
    -DImath_ROOT=${LIBDIR}
    -DUSE_PYALEMBIC=OFF
    -DUSE_ARNOLD=OFF
    -DUSE_MAYA=OFF
    -DUSE_PRMAN=OFF
    -DUSE_HDF5=OFF
    -DUSE_TESTS=OFF
    -DUSE_BINARIES=OFF
    -DALEMBIC_ILMBASE_LINK_STATIC=ON
    -DALEMBIC_SHARED_LIBS=OFF
)

# Material networks (USD, MaterialX export of shader nodes). No rendering modules (OpenGL).
add_cmake_dep(materialx MATERIALX
  CMAKE_ARGS
    -DMATERIALX_BUILD_PYTHON=OFF
    -DMATERIALX_BUILD_RENDER=OFF
    -DMATERIALX_BUILD_SHARED_LIBS=OFF
    -DMATERIALX_BUILD_TESTS=OFF
    -DMATERIALX_BUILD_VIEWER=OFF
    -DMATERIALX_BUILD_GRAPH_EDITOR=OFF
    -DMATERIALX_INSTALL_PYTHON=OFF
)
